# ── Version control ───────────────────────────────────────────────────────────
.git
.gitignore
.gitattributes

# ── Node modules (rebuilt inside Docker) ──────────────────────────────────────
**/node_modules

# ── Build outputs (rebuilt inside Docker) ─────────────────────────────────────
**/dist
**/.turbo

# ── Large binary/data files not needed for build ──────────────────────────────
backups/
screenshots/
*.dump
*.sql
*.tar
*.tar.gz
*.zip
attached_assets/

# ── Replit-specific files ──────────────────────────────────────────────────────
.replit
replit.nix
.upm/
.cache/
.agents/
.local/

# ── Logs and temp ─────────────────────────────────────────────────────────────
*.log
/tmp/

# ── Local environment (secrets come from Dokploy env panel) ───────────────────
.env
.env.local
.env.*.local

# ── OS artifacts ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
