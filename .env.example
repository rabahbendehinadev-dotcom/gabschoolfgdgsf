# ═══════════════════════════════════════════════════════════════════════════════
# GAB School — Environment Variables
# Copy to .env and fill in all values before running docker compose up
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# External PostgreSQL connection string (managed by Dokploy or your own server)
DATABASE_URL=postgresql://gabuser:STRONG_PASSWORD@your-db-host:5432/gabschool

# ── Authentication ────────────────────────────────────────────────────────────
# Random secret for JWT signing — generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX

# ── Google OAuth (Sign In with Google) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── Storage Provider ──────────────────────────────────────────────────────────
# Set to "s3" on VPS (MinIO, AWS S3, Cloudflare R2, etc.)
# Set to "replit" only on Replit (uses GCS Sidecar)
STORAGE_PROVIDER=s3

# ── S3-Compatible Storage ─────────────────────────────────────────────────────
# Works with MinIO, AWS S3, Cloudflare R2, Wasabi, etc.

S3_BUCKET=gabschool
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=your-access-key-id
S3_SECRET_ACCESS_KEY=your-secret-access-key

# For MinIO or other self-hosted providers:
S3_ENDPOINT=http://minio:9000

# For AWS S3: leave S3_ENDPOINT empty
# S3_ENDPOINT=

# ── Storage path prefixes ──────────────────────────────────────────────────────
# These replace the Replit GCS path convention.
# PRIVATE_OBJECT_DIR: prefix for user uploads and video files
# PUBLIC_OBJECT_SEARCH_PATHS: prefix for public assets (comma-separated)
#
# For S3: use "bucket-name/prefix" format
PRIVATE_OBJECT_DIR=gabschool/private
PUBLIC_OBJECT_SEARCH_PATHS=gabschool/public

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:notifications@yourdomain.com

# ── Google Drive (VPS — only needed if videos are not fully migrated to S3) ──
# Obtain refresh token by running the OAuth consent flow once:
#   node scripts/get-drive-refresh-token.js
# Then paste the refresh token below.
# LEAVE EMPTY if all videos have been migrated to S3 storage.
GOOGLE_DRIVE_REFRESH_TOKEN=

# ── Nginx ─────────────────────────────────────────────────────────────────────
NGINX_HTTP_PORT=80

# ── Node environment ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
