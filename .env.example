# ═══════════════════════════════════════════════════════════════════════════════
# GAB School — Environment Variables (VPS / Dokploy)
# Copy to .env and fill in all values before running docker compose up
# ═══════════════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────────────
# Get this from Dokploy → gabschool-db → General → Connection String
DATABASE_URL=postgresql://gabuser:STRONG_PASSWORD@online-gabschooldb-xxxxx:5432/gabschool

# ── Authentication ────────────────────────────────────────────────────────────
# Generate with: openssl rand -hex 64
JWT_SECRET=REPLACE_WITH_RANDOM_64_BYTE_HEX

# ── Google OAuth (Sign In with Google) ────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-google-client-secret

# ── Storage Provider ──────────────────────────────────────────────────────────
# local  → files stored in Docker volume at /app/data  ← USE THIS ON VPS
# replit → Replit GCS Sidecar (only on Replit)
# s3     → S3-compatible (MinIO, AWS, Cloudflare R2)
STORAGE_PROVIDER=local

# ── Local storage paths (used when STORAGE_PROVIDER=local) ───────────────────
# These map to subdirectories inside /app/data (the Docker volume)
PRIVATE_OBJECT_DIR=gabschool/private
PUBLIC_OBJECT_SEARCH_PATHS=gabschool/public

# Base URL of your app (used to generate signed upload URLs)
APP_BASE_URL=http://2.24.13.63:3000

# ── Google Drive (videos proxy) ───────────────────────────────────────────────
# Videos are served from Google Drive. Provide the OAuth refresh token.
# Get it from: Google Cloud Console → OAuth Playground
GOOGLE_DRIVE_REFRESH_TOKEN=

# ── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:notifications@yourdomain.com

# ── Node ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000
APP_PORT=3000
